# strata-rag runtime configuration (no secrets in this file).
STRATA_DATABASE_URL=postgres://strata_rag:strata_rag@127.0.0.1:5440/strata_rag
STRATA_BIND=127.0.0.1:8092
# Licence-token auth (off when unset): bearers matching no STRATA_API_TOKENS entry are checked at
# the licences service; an active licence of one of the app keys acts for its tenant.
# STRATA_LICENSE_INTROSPECT_URL=http://localhost:8544/license/introspect
# STRATA_LICENSE_APP_KEYS=strata-rag
# STRATA_LICENSE_CACHE_S=30
# STRATA_LICENSE_TIMEOUT_MS=3000
# Postgres pool: connections per process (pgbouncer pool_size must cover this x pods), seconds an
# idle connection is kept (keep below pgbouncer server_idle_timeout 240 and postgres
# idle_session_timeout 600, or the server drops it first and the next query reads EOF), and
# seconds before any connection is recycled.
STRATA_DB_MAX_CONNECTIONS=16
STRATA_DB_IDLE_TIMEOUT_S=120
STRATA_DB_MAX_LIFETIME_S=1800
# Leaf sets of at most this many chunks are searched exactly (index scans off: btree on store_id
# + sort) instead of through the HNSW index, which loses recall on small leaf sets of a big shared
# index (scripts/scale_harness/RESULTS.md). 0 = always HNSW; at most 1000000.
STRATA_EXACT_SCAN_MAX_CHUNKS=10000
STRATA_LEAF_MAX_TOKENS=1000000
STRATA_PROFILE_ALPHA=0.7
# Local bge-m3 tokenizer.json; unset = hf-hub cache, downloaded on first start. Set in the image.
# STRATA_TOKENIZER_PATH=
STRATA_CHUNK_TARGET=384
STRATA_CHUNK_OVERLAP=48
STRATA_RERANK_CANDIDATES=8
# hnsw.ef_search for the dense chunk search (1..=1000): HNSW candidates per scan step. The search
# runs with hnsw.iterative_scan = relaxed_order, so tenant/store filters still fill the list.
STRATA_HNSW_EF_SEARCH=100
# Query vectors kept in the LRU (tenant + embed lane + model + normalised text); 0 = off.
STRATA_QUERY_EMBED_CACHE=1024
# Embed / rerank providers: the deployment's providers.toml (region, mode, dialect policy and, in
# mode = "dev" only, default providers; see README "Providers"). Tenants register their own with
# PUT /api/tenant/providers.
STRATA_PROVIDERS_FILE=/etc/strata/providers.toml
# Texts per ingest embed request, and concurrent ingest embed requests per embed provider (capped
# at the provider's `concurrency`, which bounds its query-path calls), so an ingest cannot take the
# slots a query needs.
STRATA_BULK_EMBED_BATCH=32
STRATA_PROVIDER_BULK_CONCURRENCY=2
STRATA_LAYA_URL=https://api.nonagentic.ai/laya
STRATA_LAYA_MODEL=jev-latest
STRATA_LAYA_TIMEOUT_MS=800
# Wall-clock budget for all laya calls of one query (each call is also cut at the timeout above).
STRATA_LAYA_QUERY_BUDGET_MS=1200
# Chat (ask + query expansion) is a provider like embed / rerank: [default.chat] in
# providers.toml (dev) or a tenant registration; e.g. our vLLM:
#   [default.chat]
#   base_url = "https://api.nonagentic.ai/vllm/v1"
#   dialect = "openai"
#   model = "local-llm"
#   api_key = "env:VLLM_LICENSE_TOKEN"
#   regions = ["eu"]
#   zdr = true
#   timeout_ms = 15000
#   thinking = false
#   temperature = 0.2
# Seconds GET /health reuses its report (it is unauthenticated and probes laya and the default
# providers); 0 = off.
STRATA_HEALTH_CACHE_S=10
# Cost events to billing (one per embed / rerank / chat call); unset METERING_REDIS_URL = off.
METERING_STREAM=billing:costs
# Secrets: put them in the mode-600 env file or licenses.env, never here:
#   METERING_REDIS_URL=redis://...   # billing's Redis; may carry a password
#   STRATA_PROVIDER_KEY=...   # base64 of 32 random bytes (openssl rand -base64 32); seals tenant
#                             # provider keys at rest; required for PUT /api/tenant/providers
#   MLX_API_KEY=...           # or whatever env var providers.toml's api_key = "env:NAME" names
# Licence tokens live in ~/.config/strata-rag/licenses.env (chmod 600), never here:
#   LAYA_LICENSE_TOKEN=...
#   VLLM_LICENSE_TOKEN=...    # read only through providers.toml's api_key = "env:VLLM_LICENSE_TOKEN"
# Override that file's location with:
# STRATA_LICENSES_FILE=/path/to/licenses.env
